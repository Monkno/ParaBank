{
  "name": "parabank-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E suite for parabank.parasoft.com (ParaBank online banking demo)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:public": "playwright test tests/public",
    "test:auth": "playwright test tests/auth",
    "test:accounts": "playwright test tests/accounts",
    "test:api": "playwright test tests/api",
    "test:unit": "playwright test tests/unit",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
