# The only supported target for this project is the shared public demo. Paths in
# the suite are absolute under /parabank/..., so this is the scheme + host only.
BASE_URL=https://parabank.parasoft.com

# Password used for every account the suite registers. ParaBank enforces no
# complexity rule; this is here only so it can be changed without a code edit.
CUSTOMER_PASSWORD=Passw0rd1

# Parallel workers. 1 is the safe default. The public demo sits behind a
# Cloudflare limit; 2 workers have worked but have also tripped it during a full
# run. Keep this at 1, using 2 only for a deliberately faster narrow lane.
WORKERS=1

# CI sets RUN_ID automatically so generated usernames can be traced to the
# workflow run. Leave it unset locally: the factory uses a timestamp instead.
# RUN_ID=123456789-1
