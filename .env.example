# Root of the deployment. Paths in the suite are absolute under /parabank/...,
# so this is the scheme + host only. Point it at a local ParaBank container to
# run without touching the shared public demo.
BASE_URL=https://parabank.parasoft.com

# Password used for every account the suite registers. ParaBank enforces no
# complexity rule; this is here only so it can be changed without a code edit.
CUSTOMER_PASSWORD=Passw0rd1

# Parallel workers. 2, measured: the public demo sits behind a Cloudflare rate
# limit that 4 workers trip within 35 seconds (HTTP 429, "Error 1015"), and the
# ban then lasts about five minutes. See STRATEGY.md, "Parallelism". Raise it
# freely against a local ParaBank container.
WORKERS=2
